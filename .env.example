# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# AI INFERENCE PROVIDER CONFIGURATION
# ============================================================================
# Select active AI provider: "development" (default) | "snapdragon"
# When set to "development", uses server-side Gemini 3.8 Flash pipeline.
AI_INFERENCE_PROVIDER="development"

# ============================================================================
# QUALCOMM AI HUB / SNAPDRAGON NPU CONFIGURATION (OPTIONAL / ON-DEVICE EDGE)
# ============================================================================
# Model identifier or local filesystem path for Qualcomm AI Hub compiled ONNX model
# e.g., "qualcomm/Llama-3.2-3B-Instruct-ONNX" or "C:\\models\\qnn\\llama3.2_qnn.onnx"
SNAPDRAGON_MODEL_PATH=""

# Local inference daemon endpoint for Snapdragon PC (e.g. local ONNX Runtime server)
# e.g., "http://127.0.0.1:8080/v1"
SNAPDRAGON_INFERENCE_ENDPOINT=""

# Execution Provider on Snapdragon Windows PCs: "QNN" (Qualcomm Neural Network) | "DirectML" | "CPU"
SNAPDRAGON_EXECUTION_PROVIDER="QNN"
